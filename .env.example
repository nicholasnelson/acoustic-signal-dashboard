# Copy to .env and edit.
# Used by docker compose. The backend settings (ASD_*) are documented
# in backend/.env.example and can be added here too.

# Host port the app is published on
ASD_PORT=8000

# Postgres credentials
POSTGRES_USER=asd
POSTGRES_PASSWORD=asd
POSTGRES_DB=asd
# Host port Postgres is published on (loopback only), for native dev
POSTGRES_PORT=5432
