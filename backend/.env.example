# Copy to .env and edit. All settings are optional; defaults are in config.py.

# Where downloaded datasets live (defaults to <repo>/data)
# ASD_DATA_DIR=D:/datasets/mimii

# Analysis window length in seconds
# ASD_WINDOW_SECONDS=1.0

# Sample rate the pipeline resamples to (MIMII ships 16 kHz)
# ASD_SAMPLE_RATE=16000

# Extra origins allowed to call the API, as a JSON list
# ASD_CORS_ORIGINS=["http://localhost:5173"]
